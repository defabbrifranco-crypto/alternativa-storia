{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stati del prototipo",
  "type": "object",
  "required": ["meta", "states"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["reference_date", "global_warning", "verification_policy", "sources", "relations"],
      "properties": {
        "title": {"type": "string"},
        "reference_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "global_warning": {"type": "string", "minLength": 1},
        "verification_policy": {"type": "string", "minLength": 1},
        "origin": {"type": "string"},
        "sources": {"type": "object", "additionalProperties": {"type": "string"}},
        "relations": {
          "type": "object",
          "required": ["verified", "basis", "blocs", "bloc_values", "groups", "metropoles", "metropole_value"],
          "properties": {
            "verified": {"type": "boolean"},
            "basis": {"type": "string", "minLength": 1},
            "blocs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["label", "alliances"],
                "properties": {"label": {"type": "string", "minLength": 1}, "alliances": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
              }
            },
            "bloc_values": {"type": "object", "additionalProperties": {"type": "integer"}},
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label", "members", "value"],
                "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "members": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,4}$"}, "uniqueItems": true}, "value": {"type": "integer"}}
              }
            },
            "metropoles": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Z]{3,4}$"}},
            "metropole_value": {"type": "integer"}
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "capital", "capital_verified", "capital_source_id", "alliance", "alliance_verified", "alliance_source_id", "color", "playable", "flags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{3,4}$"},
          "name": {"type": "string", "minLength": 1},
          "capital": {"type": "string", "minLength": 1},
          "capital_verified": {"type": "boolean"},
          "capital_source_id": {"type": "string"},
          "alliance": {"type": "string", "minLength": 1},
          "alliance_verified": {"type": "boolean"},
          "alliance_source_id": {"type": "string"},
          "color": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "playable": {"type": "boolean"},
          "flags": {"type": "array", "items": {"enum": ["capitale_da_verificare", "alleanza_da_verificare"]}, "uniqueItems": true},
          "note": {"type": ["string", "null"]}
        }
      }
    }
  }
}
